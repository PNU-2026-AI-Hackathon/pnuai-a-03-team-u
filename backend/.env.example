# ============================================================================
# Plan-U 백엔드 환경 변수
#
# 사용법: 이 파일을 .env로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# 아래 [필수] 블록만 채우면 서버가 뜹니다. 키 순서는 팀원들이 쓰는 실제
# .env와 동일하게 맞춰두었으니 위에서부터 차례로 채우면 됩니다.
# 값을 채울 때 따옴표는 쓰지 마세요 (스마트 따옴표 “ ” 는 파싱이 깨집니다).
# ============================================================================

# --- [필수] 실행 환경 --------------------------------------------------------
# 기본값은 production이다(코드 기본값을 안전한 쪽으로 둔 것 — 배포에서 ENV를
# 빠뜨려도 보안 가드가 열리지 않게). **로컬 개발자는 이 줄을 그대로 두세요.**
# local/dev/development 중 아무거나 되고, 대소문자·앞뒤 공백은 무시됩니다.
# 이 값이 production이면 로컬에서 다음이 막힙니다:
#   - 비밀번호 재설정 링크를 서버 로그에 남기는 폴백(SMTP 미설정 시 흐름 확인용)
#   - 크롤러 스크립트의 .env PNU_LOGIN_ID/PW 폴백
ENV=local

# --- [필수] LLM API 키 ------------------------------------------------------
# OPENAI_API_KEY: 로드맵/시간표 상담 LLM + RAG 임베딩(text-embedding-3-small).
# ANTHROPIC_API_KEY: 예비(모델 스왑 실험용). 당장은 비워도 동작합니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- [필수] 데이터베이스 -----------------------------------------------------
# 팀 공유 Supabase — Transaction pooler(포트 6543) 사용.
# [project-ref]와 [password]는 팀 공유 채널에서 받아 채우세요.
# ⚠️ 이 값을 로컬 DB로 두면 학과 자동완성이 반쪽이 됩니다. 로컬 DB로 개발하려면
#    alembic upgrade head 후 `python -m scripts.seed_school_hierarchy_full` 실행.
DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# --- [필수] 인증/암호화 키 ---------------------------------------------------
# 각자 로컬에서 생성해서 채우면 됩니다:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 포털 연동 자격증명 암호화(Fernet) 키. 생성:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- [선택] 비밀번호 재설정 메일 (Resend SMTP) --------------------------------
# 발송 여부를 가르는 건 **SMTP_HOST 하나**입니다 (`app/core/mailer.py`).
#   - SMTP_HOST 비어 있음  → 메일을 안 보내고, 개발환경(ENV=local)에서만 재설정
#                            링크를 서버 로그에 남깁니다. 로컬에서 흐름만 확인할
#                            때는 아래 4줄을 주석 그대로 두면 됩니다.
#   - SMTP_HOST 있음       → 실제로 SMTP 접속을 시도합니다.
#
# ⚠️ SMTP_HOST만 켜고 SMTP_PASSWORD를 비워두지 마세요. 인증이 필요한 서버(Resend)는
#    로그인 실패로 발송이 죽는데, 그러면 메일도 안 오고 로그에 링크도 없어서
#    재설정 흐름을 아예 확인할 수 없습니다. 그래서 기본값은 **꺼둔 상태**입니다.
#    (키를 받은 뒤 아래 4줄의 주석을 푸세요.)
#
# 실제 발송 설정 (Resend, https://resend.com) — **이 한 줄이면 됩니다**
#   1) 가입 후 API Keys에서 키 발급 (re_ 로 시작)
#   2) 아래 RESEND_API에 붙여넣기 (SMTP_HOST/USER/PASSWORD는 건드릴 필요 없습니다.
#      코드가 smtp.resend.com:587 / user=resend / password=이 키로 채웁니다)
RESEND_API=
#
# ⚠️ **도메인 인증 전에는 Resend 계정을 만든 본인 메일 주소로만 발송됩니다**(샌드박스).
#    다른 주소로 보내면 550으로 거부됩니다. Plan-U 계정은 전부 @pusan.ac.kr이므로,
#    실사용하려면 resend.com/domains에서 도메인을 인증하고 SMTP_FROM을 그 도메인
#    주소로 바꿔야 합니다.
SMTP_FROM=Plan U <onboarding@resend.dev>
#
# Resend가 아닌 다른 메일 서버를 쓸 때만 아래를 채우세요 (채우면 RESEND_API보다 우선).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- [선택] Langfuse (LLM 관측·평가, https://cloud.langfuse.com) --------------
# 셋 다 값이 있어야 실제 전송됩니다 (하나라도 비면 no-op — 개발 시 꺼도 됨).
# 프로젝트 세팅 > API Keys에서 발급.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 트레이스의 user_id 해시용 salt. 아무 문자열이나:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
LANGFUSE_USER_ID_SALT=

# ============================================================================
# 아래는 전부 [선택] — 기본값(config.py)으로 충분하며, 바꿀 때만 주석을 푸세요.
# ============================================================================

# 로드맵/시간표 상담 LLM. langchain init_chat_model 형식(provider:model).
# 기본 openai:gpt-5.4-nano — 2026-08 골든 벤치(N=3)로 채택: gpt-4o-mini 대비
# pass율 79%(vs 55%), latency 7s(vs 10s), 비용 1.2배.
# ROADMAP_AGENT_MODEL=openai:gpt-5.4-nano

# 수강편람·교과목개요 적재 스크립트(scripts/)용 포털 계정. 서버 동작과 무관.
# PNU_LOGIN_ID=
# PNU_LOGIN_PW=

# CORS 허용 오리진 (쉼표 구분). 배포 프론트 주소가 생기면 추가.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 메일 본문에 담길 재설정 화면 주소.
# ⚠️ **배포에서는 반드시 채워야 합니다.** 기본값이 localhost라, 안 채우면 메일은 정상
#    발송되는데 링크가 받는 사람 PC의 localhost를 가리켜 아무 데도 열리지 않습니다
#    (발송이 성공하니 아무도 눈치채지 못합니다). ENV가 개발이 아닌데 이 값이 로컬
#    주소면 기동 시 error 로그가 남습니다.
# PASSWORD_RESET_URL_BASE=https://planu-pnu.netlify.app/reset-password
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# 레이트 리밋. 로컬에서 반복 테스트할 때 끄려면 false.
# RATE_LIMIT_ENABLED=true
# 워커 여러 개로 스케일아웃하면 공유 저장소 지정 (예: redis://...).
# RATE_LIMIT_STORAGE_URI=
# 한도 조정 예: RATE_LIMIT_LOGIN=5/minute;30/hour · RATE_LIMIT_CHAT=10/minute;100/day
