ANTHROPIC_API_KEY=
# 비교과 활동/사용자 프로필 임베딩(text-embedding-3-small)에 사용
OPENAI_API_KEY=
# 로드맵/시간표 상담 LLM. langchain init_chat_model 형식(provider:model).
# 기본은 openai:gpt-5.4-nano(Luna) — 2026-08 골든 데이터셋 벤치 결과(N=3)로
# 채택: gpt-4o-mini 대비 pass율 79%(vs 55%), latency 7s(vs 10s), 비용 1.2배.
# 다른 모델로 실험하려면 이 값을 바꿔라. 미지정 시 config.py 기본값 사용.
# ROADMAP_AGENT_MODEL=openai:gpt-5.4-nano
# Supabase (팀 공유 DB) — Transaction pooler 사용 (포트 6543)
# 비밀번호는 팀 공유 채널에서 받으세요
DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[password]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
PNU_LOGIN_ID=
PNU_LOGIN_PW=
CREDENTIAL_ENCRYPTION_KEY=
# 자체 로그인(JWT) 서명 키. 각자 로컬에서 생성:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
# 쉼표로 구분. 실제 프론트엔드 배포 주소가 추가되면 함께 등록하세요.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://pnuai-a-03-team-u.vercel.app

# --- 비밀번호 재설정 메일 (Resend SMTP) ---
# SMTP_HOST가 비어 있으면 메일을 보내지 않고 재설정 링크를 서버 로그에만 남깁니다.
# 로컬에서 흐름만 확인할 때는 비워두면 됩니다.
#
# 실제 발송 설정 (Resend, https://resend.com)
#   1) 가입 후 API Keys 에서 키 발급 (re_ 로 시작)
#   2) 아래 SMTP_PASSWORD 에 그 키를 붙여넣기 (SMTP_USER 는 고정값 "resend")
#
# ⚠️ 도메인 인증 전에는 SMTP_FROM 을 onboarding@resend.dev 로 두어야 하고,
#    이때는 Resend 계정을 만든 본인 메일 주소로만 발송됩니다(샌드박스 제한).
#    다른 주소로도 보내려면 Resend 에서 도메인을 인증하고 SMTP_FROM 을 바꾸세요.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=Plan U <onboarding@resend.dev>

# 메일 본문에 담길 재설정 화면 주소. 배포 시 프론트 주소로 바꾸세요.
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Langfuse (LLM 관측·평가, https://cloud.langfuse.com) ---
# 개인 Cloud 프로젝트 `planu-backend` API 키. 셋 다 값이 있어야 실제 전송된다
# (하나라도 비면 콜백이 no-op이라 개발 시 켜지 않아도 됨).
# 프로젝트 세팅 > API Keys 에서 발급.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 아래는 user_id 해시용 salt. 각자 로컬로 아무 문자열이나 채우면 됨.
# python -c "import secrets; print(secrets.token_urlsafe(16))"
LANGFUSE_USER_ID_SALT=
